# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster/db

# Required in production (min 32 characters)
JWT_SECRET=your-long-random-secret-at-least-32-chars

# Frontend URL for password-reset emails
FRONTEND_URL=https://machine-mechanics-frontend.vercel.app

# CORS (comma-separated, no spaces unless after comma)
APP_CORS_ORIGINS=http://localhost:5173,https://machine-mechanics-frontend.vercel.app

# Session cookies (local HTTP dev: SESSION_COOKIE_SECURE=false, SESSION_SAME_SITE=lax)
SESSION_COOKIE_SECURE=true
SESSION_SAME_SITE=none

# Brevo email
BREVO_API_KEY=

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
